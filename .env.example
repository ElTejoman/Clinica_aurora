# -----------------------------------------------------------------------------
# Variables de entorno de Clínica Aurora (todas públicas: sitio estático).
#
#   .env.production  → se usa en `npm run build` (ya está en el repositorio)
#   .env.local       → overrides locales (copia este archivo; no se sube a git)
#
# Las NEXT_PUBLIC_* se incrustan en el HTML/JS al compilar: nunca pongas
# secretos aquí y recompila después de cambiarlas.
# -----------------------------------------------------------------------------

# Dominio público (metadatos, sitemap, datos estructurados). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pon "false" para apagar todas las animaciones (three.js + anime.js).
NEXT_PUBLIC_ENABLE_MOTION=true
