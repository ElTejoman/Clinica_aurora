# ---------------------------------------------------------------------------
# Variables de entorno de Clínica Aurora.
# Copia este archivo como `.env.local` y completa los valores.
# Las variables que empiezan con NEXT_PUBLIC_ se exponen al navegador.
# ---------------------------------------------------------------------------

# URL pública del sitio (se usa en metadatos, sitemap y datos estructurados).
NEXT_PUBLIC_SITE_URL=https://www.clinicaaurora.pe

# (Opcional) Webhook al que la API de citas enviará cada reserva nueva
# (por ejemplo, un flujo de n8n/Make/Zapier que guarda en la agenda y manda WhatsApp).
APPOINTMENTS_WEBHOOK_URL=

# (Opcional) ID de Google Analytics 4 / Meta Pixel para medir el embudo.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
